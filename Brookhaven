local function DesativarGuisDaTela()
    local guisParaRestaurar = {}
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Enabled then
                table.insert(guisParaRestaurar, {Gui = gui, Prop = "Enabled", Val = true})
                gui.Enabled = false
            end
        end
    end

    pcall(function()
        local coreGui = game:GetService("CoreGui")
        if coreGui then
            for _, gui in ipairs(coreGui:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Enabled and not string.find(gui.Name, "Roblox") and not string.find(gui.Name, "NightCustomAvisoGui") then
                    table.insert(guisParaRestaurar, {Gui = gui, Prop = "Enabled", Val = true})
                    gui.Enabled = false
                end
            end
        end
    end)

    return function()
        for _, item in ipairs(guisParaRestaurar) do
            if item.Gui and item.Gui.Parent then
                pcall(function()
                    item.Gui[item.Prop] = item.Val
                end)
            end
        end
    end
end

