local function StartBrookhaven()
    local loadingGui, UpdateLoading = CreateNightLoadingScreen()
    local startedAt = os.clock()
    local loadFinished = false
    local loadSucceeded = false
    local loadError = nil

    -- O carregamento visual dura pelo menos 10 segundos; se o hub demorar mais,
    -- a porcentagem aguarda em 95% até a inicialização real terminar.
    task.spawn(function()
        local ok, err = xpcall(StartNightHub, function(message)
            return debug.traceback(tostring(message), 2)
        end)
        loadSucceeded = ok
        loadError = err
        loadFinished = true
    end)

    local stages = {
        {0, "Inicializando ambiente..."},
        {12, "Preparando recursos do Brookhaven..."},
        {24, "Verificando recursos do jogo..."},
        {36, "Carregando ferramentas e personagens..."},
        {48, "Preparando interface principal..."},
        {60, "Carregando funções do Night Hub..."},
        {72, "Conectando recursos do jogo..."},
        {84, "Organizando módulos e configurações..."},
        {95, "Finalizando inicialização..."},
    }

    for i, stage in ipairs(stages) do
        local targetTime = (i - 1) * (10 / (#stages - 1))
        local waitTime = targetTime - (os.clock() - startedAt)
        if waitTime > 0 then task.wait(waitTime) end
        UpdateLoading(stage[1], stage[2])
    end

    while not loadFinished do
        UpdateLoading(95, "Quase pronto, finalizando...")
        task.wait(0.15)
    end

    if loadSucceeded then
        UpdateLoading(100, "Night Hub carregado com sucesso!")
        task.wait(0.25)

        -- Transição de saída: anéis se expandem, o cartão dá um pequeno zoom,
        -- inclina e desaparece enquanto o fundo revela a interface principal.
        if loadingGui and loadingGui.Parent then
            local card = loadingGui:FindFirstChild("LoadingCard")
            local background = loadingGui:FindFirstChild("NightBackground")
            local shade = loadingGui:FindFirstChild("PurpleShade")

            if card then
                local cardScale = Instance.new("UIScale")
                cardScale.Scale = 1
                cardScale.Parent = card

                for ringIndex = 1, 2 do
                    local ring = Instance.new("Frame")
                    ring.Name = "LoadingExitPulse" .. ringIndex
                    ring.AnchorPoint = Vector2.new(0.5, 0.5)
                    ring.Position = UDim2.new(0.5, 0, 0, 114)
                    ring.Size = UDim2.fromOffset(108, 108)
                    ring.BackgroundTransparency = 1
                    ring.BorderSizePixel = 0
                    ring.ZIndex = 9
                    ring.Parent = card

                    local ringCorner = Instance.new("UICorner")
                    ringCorner.CornerRadius = UDim.new(1, 0)
                    ringCorner.Parent = ring

                    local ringStroke = Instance.new("UIStroke")
                    ringStroke.Color = ringIndex == 1 and Color3.fromRGB(191, 105, 255) or Color3.fromRGB(255, 145, 225)
                    ringStroke.Thickness = ringIndex == 1 and 3 or 2
                    ringStroke.Transparency = 0.08
                    ringStroke.Parent = ring

                    task.delay((ringIndex - 1) * 0.12, function()
                        if ring and ring.Parent then
                            BootstrapTweenService:Create(
                                ring,
                                TweenInfo.new(0.72, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
                                {Size = UDim2.fromOffset(300, 300)}
                            ):Play()
                            BootstrapTweenService:Create(
                                ringStroke,
                                TweenInfo.new(0.72, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
                                {Transparency = 1, Thickness = 1}
                            ):Play()
                        end
                    end)
                end

                BootstrapTweenService:Create(
                    cardScale,
                    TweenInfo.new(0.78, Enum.EasingStyle.Back, Enum.EasingDirection.In),
                    {Scale = 0.72}
                ):Play()
                BootstrapTweenService:Create(
                    card,
                    TweenInfo.new(0.78, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
                    {Position = UDim2.new(0.5, 0, 0.39, 0), Rotation = 5}
                ):Play()

                for _, object in ipairs(card:GetDescendants()) do
                    if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                        BootstrapTweenService:Create(object, TweenInfo.new(0.58, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 1}):Play()
                    elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
                        BootstrapTweenService:Create(object, TweenInfo.new(0.68, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {ImageTransparency = 1}):Play()
                    elseif object:IsA("UIStroke") then
                        BootstrapTweenService:Create(object, TweenInfo.new(0.58, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1}):Play()
                    elseif object:IsA("Frame") and object.Name ~= "LoadingExitPulse1" and object.Name ~= "LoadingExitPulse2" then
                        BootstrapTweenService:Create(object, TweenInfo.new(0.58, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
                    end
                end
            end

            if background then
                BootstrapTweenService:Create(background, TweenInfo.new(0.82, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {ImageTransparency = 1}):Play()
            end
            if shade then
                BootstrapTweenService:Create(shade, TweenInfo.new(0.72, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
            end

            task.wait(0.85)
            if loadingGui and loadingGui.Parent then loadingGui:Destroy() end
        end
    else
        UpdateLoading(100, "Falha ao iniciar: " .. tostring(loadError))
        warn("[Night Hub] Erro ao iniciar: " .. tostring(loadError))
        task.wait(4)
        if loadingGui and loadingGui.Parent then loadingGui:Destroy() end
    end
end

-- Carrega a Fluent original (dawid-scripts) pela URL oficial da versão mais recente.
-- A URL fica explícita aqui para evitar iniciar a janela sem carregar a biblioteca.
local fluentSourceOk, fluentSource = pcall(function()
    return game:HttpGet(FLUENT_URL, true)
end)

if not fluentSourceOk or type(fluentSource) ~= "string" or fluentSource == "" then
    warn("[Night Hub] Falha ao baixar a Fluent original em: " .. FLUENT_URL .. " | " .. tostring(fluentSource))
    return
end

local fluentCompileOk, fluentChunk = pcall(function()
    return loadstring(fluentSource)
end)

if not fluentCompileOk or type(fluentChunk) ~= "function" then
    warn("[Night Hub] Falha ao compilar a Fluent original: " .. tostring(fluentChunk))
    return
end

local fluentLoaded, Fluent = pcall(fluentChunk)
if not fluentLoaded or not Fluent then
    warn("[Night Hub] Falha ao iniciar a Fluent original: " .. tostring(Fluent))
    return
end

