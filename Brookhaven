        local destination = hit.Position + Vector3.new(0, 3, 0)
        MorphBurst(destination, Color3.fromRGB(255, 20, 35), Color3.fromRGB(35, 0, 0), 150)
        root.CFrame = CFrame.new(destination, destination + root.CFrame.LookVector)
    end)
    MorphGiveTool("Goner Attack", function()
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not (humanoid and root) then return end
        -- Movimento curto e partículas locais; não depende de animação externa.
        local old = root.CFrame
        root.CFrame = old * CFrame.new(0, 0, -1)
        MorphBurst((root.CFrame * CFrame.new(0, 0, -3)).Position, Color3.fromRGB(255, 0, 30), Color3.fromRGB(10, 10, 10), 110)
        task.delay(0.12, function()
            if root and root.Parent then root.CFrame = old end
