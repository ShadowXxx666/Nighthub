local function LimparToolsDoJogador(targetPlayer)
    if not targetPlayer then return end
    pcall(function()
        local backpack = targetPlayer:FindFirstChildOfClass("Backpack")
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") then
                    item:Destroy()
                end
            end
        end

        local char = targetPlayer.Character
        if char then
            for _, item in ipairs(char:GetChildren()) do
                if item:IsA("Tool") then
                    item:Destroy()
                end
            end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum:UnequipTools() end
        end
    end)
end

local function PararAntiTool()
    antiToolEnabled = false
    for _, conn in ipairs(antiToolConnections) do
        if conn and typeof(conn) == "RBXScriptConnection" and conn.Connected then
            conn:Disconnect()
        end
    end
    table.clear(antiToolConnections)
end

local function IniciarAntiTool()
    PararAntiTool()
    antiToolEnabled = true

    local targetPlayer = selectedPlayerName and Players:FindFirstChild(selectedPlayerName)
    if not targetPlayer or targetPlayer == LocalPlayer then
        antiToolEnabled = false
        CriarAvisoCustom("Selecione um jogador vÃ¡lido primeiro!")
        return
    end

    LimparToolsDoJogador(targetPlayer)

    local backpack = targetPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        table.insert(antiToolConnections, backpack.ChildAdded:Connect(function(child)
            if antiToolEnabled and child:IsA("Tool") then
                task.defer(function()
                    if child and child.Parent then child:Destroy() end
                end)
            end
        end))
    end

    if targetPlayer.Character then
        table.insert(antiToolConnections, targetPlayer.Character.ChildAdded:Connect(function(child)
            if antiToolEnabled and child:IsA("Tool") then
                task.defer(function()
                    if child and child.Parent then child:Destroy() end
                end)
            end
        end))
    end

    table.insert(antiToolConnections, targetPlayer.CharacterAdded:Connect(function(char)
        if not antiToolEnabled then return end
        table.insert(antiToolConnections, char.ChildAdded:Connect(function(child)
            if antiToolEnabled and child:IsA("Tool") then
                task.defer(function()
                    if child and child.Parent then child:Destroy() end
                end)
            end
        end))
        task.wait(0.1)
        LimparToolsDoJogador(targetPlayer)
    end))

    task.spawn(function()
        while antiToolEnabled and isHubRunning and targetPlayer.Parent do
            LimparToolsDoJogador(targetPlayer)
            task.wait(0.15)
        end
    end)

    CriarAvisoCustom("Anti Tool ativado em " .. targetPlayer.Name)
end

