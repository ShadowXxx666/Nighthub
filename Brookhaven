local function MorphStartDrone()
    if droneActive then MorphStopDrone(); return end
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then CriarAvisoCustom("Seu personagem ainda não carregou."); return end
    droneActive = true
    local model = Instance.new("Model")
    model.Name = "NightHub_Drone_Local"
    local core = Instance.new("Part")
    core.Name = "Core"; core.Size = Vector3.new(2.6, 0.45, 2.6)
    core.Material = Enum.Material.Metal; core.Color = Color3.fromRGB(35, 25, 55)
    core.Anchored = true; core.CanCollide = false; core.Parent = model
    for _, offset in ipairs({Vector3.new(1.8,0,1.8), Vector3.new(-1.8,0,1.8), Vector3.new(1.8,0,-1.8), Vector3.new(-1.8,0,-1.8)}) do
        local arm = Instance.new("Part")
        arm.Size = Vector3.new(1.2, 0.12, 0.12); arm.Material = Enum.Material.Neon
        arm.Color = Color3.fromRGB(190, 60, 255); arm.Anchored = true; arm.CanCollide = false
        arm.CFrame = CFrame.new(offset / 2, core.Position) -- repositioned each frame below
        arm.Parent = model
    end
    model.PrimaryPart = core
    model.Parent = workspace
    droneModel = model
    local start = root.Position + Vector3.new(0, 2.8, 0)
    local droneCFrame = CFrame.new(start, start + root.CFrame.LookVector)
    local speed = 0
    droneConnection = RunService.RenderStepped:Connect(function(dt)
        if not droneActive or not droneModel or not droneModel.Parent then return end
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local cam = workspace.CurrentCamera
        local forward = cam and cam.CFrame.LookVector or droneCFrame.LookVector
        local right = cam and cam.CFrame.RightVector or droneCFrame.RightVector
        local move = Vector3.zero
        if droneKeys.W then move += Vector3.new(forward.X, 0, forward.Z) end
        if droneKeys.S then move -= Vector3.new(forward.X, 0, forward.Z) end
        if droneKeys.D then move += Vector3.new(right.X, 0, right.Z) end
        if droneKeys.A then move -= Vector3.new(right.X, 0, right.Z) end
        if move.Magnitude > 0 then move = move.Unit * 24 * dt end
        local vertical = ((droneKeys.Space and 1 or 0) - (droneKeys.LeftControl and 1 or 0)) * 18 * dt
        local pos = droneCFrame.Position + move + Vector3.new(0, vertical, 0)
        droneCFrame = CFrame.new(pos, pos + Vector3.new(forward.X, 0, forward.Z))
        droneModel:PivotTo(droneCFrame)
        -- Personagem fica visualmente sentado/posicionado sobre o drone; tudo local.
        hrp.CFrame = droneCFrame * CFrame.new(0, 2.4, 0)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.Sit = false end
        for _, inputName in ipairs({"W", "A", "S", "D", "Space", "LeftControl"}) do
            -- Teclas são lidas por InputBegan/InputEnded abaixo.
        end
    end)
    CriarAvisoCustom("Drone visual ativado: use WASD, Espaço para subir e Ctrl para descer. Toque em Desligar Drone para sair.")
end

