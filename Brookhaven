        end
    end
    table.sort(names)
    return names
end

local function AvatarRefreshPlayers()
    if not avatarPlayerDropdown then return end
    local names = AvatarPlayerNames()
    pcall(function() avatarPlayerDropdown:Set(names) end)
    if avatarSelectedPlayer and not Players:FindFirstChild(avatarSelectedPlayer) then
        avatarSelectedPlayer = nil
        pcall(function() avatarPlayerDropdown:Set("") end)
    end
    CriarAvisoCustom("Lista de jogadores atualizada!")
end

local function AvatarWear(assetId)
    local remote = AvatarWearRemote
    if not remote or not tonumber(assetId) then
        CriarAvisoCustom("Remote de roupas indisponivel nesta versao do jogo.")
        return false
    end
    local ok, err = pcall(function()
        remote:InvokeServer(tonumber(assetId))
    end)
    if not ok then
        warn("Night Hub Avatar - Wear: " .. tostring(err))
        CriarAvisoCustom("Nao foi possivel aplicar esse item.")
        return false
    end
    return true
end

