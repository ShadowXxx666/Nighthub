local function PropTemSeatWeld(model)
    if not model then return false end
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("Seat") and desc:FindFirstChild("SeatWeld") then return true end
    end
    return false
end

local function MoverPropInstantaneo(propItem, targetCFrame)
    if not propItem or not propItem.Remote then return end
    propItem.LastCFrame = targetCFrame
    pcall(function()
        if propItem.Remote:IsA("RemoteFunction") then
            propItem.Remote:InvokeServer(targetCFrame)
        elseif propItem.Remote:IsA("RemoteEvent") then
            propItem.Remote:FireServer(targetCFrame)
        end
    end)
end

local function MoverPropSuave(propItem, targetCFrame)
    if not propItem or not propItem.Remote then return end
    local smoothCFrame = propItem.LastCFrame:Lerp(targetCFrame, 0.97)
    propItem.LastCFrame = smoothCFrame

    task.spawn(function()
        pcall(function()
            if propItem.Remote:IsA("RemoteFunction") then
                propItem.Remote:InvokeServer(smoothCFrame)
            elseif propItem.Remote:IsA("RemoteEvent") then
                propItem.Remote:FireServer(smoothCFrame)
            end
        end)
    end)
end

