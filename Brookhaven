local function MorphBurst(position, colorA, colorB, count)
    local holder = Instance.new("Part")
    holder.Name = "NightHub_MorphFX_Local"
    holder.Anchored = true
    holder.CanCollide = false
    holder.Transparency = 1
    holder.Size = Vector3.new(1, 1, 1)
    holder.CFrame = CFrame.new(position)
    holder.Parent = workspace
    local att = Instance.new("Attachment")
    att.Parent = holder
    local emitter = Instance.new("ParticleEmitter")
    emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emitter.Color = ColorSequence.new(colorA, colorB)
    emitter.LightEmission = 0.35
    emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0)})
    emitter.Lifetime = NumberRange.new(0.45, 1.1)
    emitter.Speed = NumberRange.new(8, 20)
    emitter.SpreadAngle = Vector2.new(180, 180)
    emitter.Rate = 0
    emitter.Parent = att
    emitter:Emit(count or 80)
    task.delay(2, function() if holder then holder:Destroy() end end)
end

local function MorphGiveTool(name, onActivate)
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then CriarAvisoCustom("Mochila ainda não está pronta."); return end
    local old = backpack:FindFirstChild(name) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(name))
    if old then old:Destroy() end
    local tool = Instance.new("Tool")
    tool.Name = name
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.ToolTip = "Night Hub • efeito visual local"
    tool.Activated:Connect(function()
        if tool.Parent == backpack or (LocalPlayer.Character and tool.Parent == LocalPlayer.Character) then
            onActivate(tool)
        end
    end)
    tool.Parent = backpack
end

local function MorphCreateGonerTools()
    MorphGiveTool("Goner TP", function()
        local mouse = LocalPlayer:GetMouse()
        local hit = mouse and mouse.Hit
        local character = LocalPlayer.Character
