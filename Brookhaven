local function ObterListaDeCarrosSpawnados()
    local listaCarros = {}
    local searchRoot = workspace:FindFirstChild("WorkspaceCom") or workspace
    for _, obj in ipairs(searchRoot:GetDescendants()) do
        if obj:IsA("Model") and (string.find(string.lower(obj.Name), "car") or obj:FindFirstChild("VehicleSeat", true) or obj:FindFirstChild("Seat", true)) then
            if not table.find(listaCarros, obj.Name) then
                table.insert(listaCarros, obj.Name)
            end
        end
    end
    if #listaCarros == 0 then
        table.insert(listaCarros, "Nenhum Carro Encontrado")
    end
    return listaCarros
end

local function EncontrarModeloCarroPorNome(nomeCarro)
    local searchRoot = workspace:FindFirstChild("WorkspaceCom") or workspace
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == nomeCarro then
            local seat = obj:FindFirstChild("VehicleSeat", true) or obj:FindFirstChild("Seat", true)
            if seat then return obj, seat end
        end
    end
    return nil, nil
end

local function ObterTodosOsAssentosDeCarros()
    local assentos = {}
    local searchRoot = workspace
    for _, obj in ipairs(searchRoot:GetDescendants()) do
        if obj:IsA("VehicleSeat") or (obj:IsA("Seat") and obj.Parent and string.find(string.lower(obj.Parent.Name), "car")) then
            table.insert(assentos, obj)
        end
    end
    return assentos
end

