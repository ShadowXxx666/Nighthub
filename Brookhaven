local function EncontrarJogadorPorNome(texto)
    if not texto or texto == "" then return nil end
    local termo = string.lower(tostring(texto))

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and string.lower(player.Name) == termo then return player end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and string.sub(string.lower(player.Name), 1, #termo) == termo then return player end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and string.find(string.lower(player.Name), termo, 1, true) then return player end
    end
    return nil
end

