local function StartSpectraRGB()
    task.spawn(function()
        while spectraRGBEnabled and isHubRunning do
            for _, color in ipairs(spectraRGBColors) do
                if not spectraRGBEnabled or not isHubRunning then break end
                if RPColorRemote then
                    pcall(function()
                        RPColorRemote:FireServer("PickingRPNameColor", color)
                        RPColorRemote:FireServer("PickingRPBioColor", color)
                    end)
                else
                    CriarAvisoCustom("Remote RGB do Brookhaven indisponível.")
                    spectraRGBEnabled = false
                    return
                end
                task.wait(spectraRGBSpeed)
            end
        end
    end)
end

