local function ExecutarGiveToolAcao()
    if not selectedPlayerName or selectedPlayerName == "..." or selectedPlayerName == "" then
        CriarAvisoCustom("Selecione um jogador primeiro!")
        return
    end

    local targetPlayer = Players:FindFirstChild(selectedPlayerName)
    if not targetPlayer or not TargetEstaValidoParaCaptura(targetPlayer.Character) then
        CriarAvisoCustom("Jogador invÃ¡lido ou offline!")
        return
    end

    task.spawn(function()
        local localChar = LocalPlayer.Character
        local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")
        if not localHRP then return end
        
        local posOriginal = localHRP.CFrame
        local giveToolName = selectedGiveToolName or "FloorCushion"
        
        local toolInstance = ObterOuEquiparToolCustomizada(giveToolName)
        if not toolInstance then
            CriarAvisoCustom("NÃ£o foi possÃ­vel obter a ferramenta selecionada!")
            return
        end

        noclipEnabled = true
        local sessionId = currentSessionId
        local timeStep = 0
        local jogouNoVoid = false

        while isHubRunning and sessionId == currentSessionId do
            RunService.Heartbeat:Wait()
            timeStep = timeStep + 0.1

            local targetChar = targetPlayer.Character
            local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            local targetHead = targetChar and targetChar:FindFirstChild("Head")
            local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")

            if not targetHRP or not targetHead or not targetHum or targetHum.Health <= 0 then break end

            local propsAtuais = ObterPropsDoUsuarioCustom(giveToolName)
            local alvoSentou = false

            for _, prop in ipairs(propsAtuais) do
                if PropTemSeatWeld(prop.Model) then alvoSentou = true break end
            end

            if alvoSentou then
                jogouNoVoid = true
                local destinoVoid = CFrame.new(targetHRP.Position.X, -1000, targetHRP.Position.Z)
                for _, prop in ipairs(propsAtuais) do MoverPropSuave(prop, destinoVoid) end
                task.wait(0.3)
                break
            else
                local angulo = timeStep * 25
                local targetCFrame = targetHead.CFrame * CFrame.new(0, 0, 0) * CFrame.Angles(0, angulo, math.sin(timeStep * 10) * 2)
                for _, prop in ipairs(propsAtuais) do MoverPropSuave(prop, targetCFrame) end
            end
        end

        noclipEnabled = false
        DesequiparFerramenta()
        task.wait(0.1)
        if localHRP and sessionId == currentSessionId then
            localHRP.CFrame = posOriginal
        end

        if jogouNoVoid then
            CriarAvisoCustom("Ferramenta entregue com sucesso!")
        else
            CriarAvisoCustom("AÃ§Ã£o de Give Tool finalizada!")
        end
    end)
end

