local function ObterPropsDoUsuario()
    local listaProps = {}
    local searchRoot = workspace:FindFirstChild("WorkspaceCom") or workspace
    local myNameLower = string.lower(LocalPlayer.Name)

    for _, obj in ipairs(searchRoot:GetDescendants()) do
        local objName = string.lower(obj.Name)
        if string.find(objName, myNameLower) or string.find(objName, "prop") or string.find(objName, "couch") then
            local setRemote = obj:FindFirstChild("SetCurrentCFrame", true)
            if setRemote then
                table.insert(listaProps, {
                    Model = obj,
                    Remote = setRemote,
                    LastCFrame = obj:IsA("BasePart") and obj.CFrame or (obj.PrimaryPart and obj.PrimaryPart.CFrame) or CFrame.new()
                })
            end
        end
    end
    return listaProps
end

